POSTGRES_DB=library_db
POSTGRES_USER=library_user
POSTGRES_PASSWORD=CHANGE_TO_A_URL_SAFE_PASSWORD
# Set DATABASE_URL to an Amazon RDS PostgreSQL URL when RDS is ready.
DATABASE_URL=
SERVICE_NAME=library-flask-api
LOG_LEVEL=INFO
JWT_SECRET_KEY=CHANGE_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_HOURS=24
CORS_ORIGINS=*
LOGIN_LIMIT=8
LOGIN_WINDOW_SECONDS=300
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ADMIN_PASSWORD
DEFAULT_USER_USERNAME=user
DEFAULT_USER_PASSWORD=CHANGE_USER_PASSWORD
MAX_UPLOAD_MB=8
UPLOAD_FOLDER=/app/uploads

# Optional S3/CloudFront image storage. Leave empty to use the local upload volume.
AWS_REGION=ap-southeast-2
AWS_IMAGE_BUCKET=
AWS_IMAGE_BASE_URL=

# Optional Amazon SES password-recovery email.
SES_FROM_EMAIL=
RESET_URL_BASE=http://localhost/reset-password
EXPOSE_RESET_TOKEN=false

# Optional AWS X-Ray instrumentation.
ENABLE_XRAY=false
